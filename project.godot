;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Enginuity"
run/main_scene="uid://cli6v0y6jnsjh"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="uid://cw7ao6e50cpxy"

[autoload]

Transition="*uid://bkunsfdvbaohx"
Global="*uid://ccn22cd4vi2sa"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_super-wakatime/plugin.cfg")

[file_customization]

